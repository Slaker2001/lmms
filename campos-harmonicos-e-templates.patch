+const harmonic::Mode& PianoRoll::currentHarmonicMode() const
+{
+	const auto& all = harmonic::modes();
+	const int index = std::clamp(static_cast<int>(m_harmonicModeModel.value()), 0, static_cast<int>(all.size()) - 1);
+	return all[index];
+}
